{
    "name": "ataurbdx/authenticator",
    "version": "1.0.5",
    "description": "Universal Modular Authentication & Security Engine for Laravel.",
    "keywords": [
        "laravel",
        "authentication",
        "authenticator",
        "otp",
        "two-factor",
        "2fa",
        "pin-lock",
        "socialite",
        "ataurbdx"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ataur Rahman",
            "email": "ataurrahman.wub@gmail.com",
            "role": "Lead Architect"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0"
    },
    "suggest": {
        "laravel/socialite": "Required to use the dynamic Social Accounts OAuth module (^5.0)."
    },
    "autoload": {
        "psr-4": {
            "Ataurbdx\\Authenticator\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ataurbdx\\Authenticator\\AuthenticatorServiceProvider"
            ],
            "aliases": {
                "Authenticator": "Ataurbdx\\Authenticator\\Facades\\Authenticator"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
